{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hqbase-prod",
  "main": "worker/index.ts",
  "preview_urls": false,
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/mcp/*",
      "/.well-known/*",
      "/skills/hqbase-mail/SKILL.md",
      "/AGENTS.md",
      "/agents.md"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hqbase-prod",
      "database_id": "f9fb2ffa-5b17-47ac-8316-788083271871",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_OBJECTS",
      "bucket_name": "hqbase-prod-mail"
    }
  ],
  "queues": {
    "producers": [{ "binding": "HQBASE_JOBS", "queue": "hqbase-prod-jobs" }],
    "consumers": [
      {
        "queue": "hqbase-prod-jobs",
        "dead_letter_queue": "hqbase-prod-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "triggers": { "crons": ["17 3 * * *"] },
  "send_email": [
    {
      "name": "MAIL_SENDER"
    }
  ],
  "vars": {
    "CLOUDFLARE_OAUTH_MODE": "official",
    "HQBASE_APP_VERSION": "1.1.0",
    "HQBASE_WORKER_NAME": "hqbase-prod",
    "BETTER_AUTH_URL": "https://hotmail.allinaigc.org"
  },
  "routes": [
    {
      "pattern": "hotmail.allinaigc.org",
      "custom_domain": true
    }
  ]
}
